# librus-watch: wzorzec sekretów jako zmiennych środowiskowych.
# Skopiuj do .env (ten plik jest w .gitignore). Wygodne lokalnie.
#
# Na serwerze lepiej użyć plików sekretów: zamiast NAZWA=wartość ustaw
# NAZWA_FILE=/run/secrets/nazwa (sekrety Podmana lub Dockera). Wtedy wartość
# nie jest widoczna w `podman inspect` ani `docker inspect`.

# Dla każdego dziecka z config.yaml: LIBRUS_<ID>_LOGIN i LIBRUS_<ID>_PASSWORD.
# Login RODZICA w Synergii (np. 1234567), nie ucznia (1234567u): każde dziecko
# ma osobny login rodzica.
LIBRUS_ANIA_LOGIN=
LIBRUS_ANIA_PASSWORD=
LIBRUS_KUBA_LOGIN=
LIBRUS_KUBA_PASSWORD=

# Kanały powiadomień Apprise: w każdej linii `tagi=URL`.
# Przykład dla Telegrama: rodzice=tgram://<token_bota>/<id_czatu>
APPRISE_CONFIG=

# Klucz API modelu (tylko gdy llm.api_key_required: true)
LLM_API_KEY=

# Ścieżka do konfiguracji
LIBRUS_WATCH_CONFIG=/config/config.yaml

# Bot Telegrama z przyciskami ocen (ADR-019): token od @BotFather i dozwolone czaty
TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram_bot_token
TELEGRAM_CHAT_IDS_FILE=/run/secrets/telegram_chat_ids

# Bot WhatsAppa (ADR-024, Cloud API): token, ID numeru, sekret aplikacji, token weryfikacji webhooka, odbiorcy
WHATSAPP_TOKEN_FILE=/run/secrets/whatsapp_token
WHATSAPP_PHONE_ID_FILE=/run/secrets/whatsapp_phone_id
WHATSAPP_APP_SECRET_FILE=/run/secrets/whatsapp_app_secret
WHATSAPP_VERIFY_TOKEN_FILE=/run/secrets/whatsapp_verify_token
WHATSAPP_TO_FILE=/run/secrets/whatsapp_to
