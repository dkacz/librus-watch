# librus-watch jako usługa systemd przez Podman Quadlet (tryb użytkownika).
# Skopiuj do ~/.config/containers/systemd/librus-watch.container,
# uzupełnij ścieżki i sekrety, potem:
#   systemctl --user daemon-reload && systemctl --user start librus-watch
#
# Sekrety tworzysz wcześniej, np.:
#   printf '%s' '...' | podman secret create librus_ania_password -

[Unit]
Description=librus-watch: powiadomienia o odstępstwach od normalnego dnia szkolnego
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/librus-watch:latest
ContainerName=librus-watch
Exec=run

Volume=librus-watch-data:/data:Z
Volume=%h/.config/librus-watch/config.yaml:/config/config.yaml:ro,Z

Environment=TZ=Europe/Warsaw
Environment=LIBRUS_WATCH_CONFIG=/config/config.yaml

Secret=librus_ania_login
Secret=librus_ania_password
Secret=apprise_config
Environment=LIBRUS_ANIA_LOGIN_FILE=/run/secrets/librus_ania_login
Environment=LIBRUS_ANIA_PASSWORD_FILE=/run/secrets/librus_ania_password
Environment=APPRISE_CONFIG_FILE=/run/secrets/apprise_config
# Tylko dla zdalnego API modelu:
# Secret=llm_api_key
# Environment=LLM_API_KEY_FILE=/run/secrets/llm_api_key

# Bezpieczeństwo
User=10001
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
Tmpfs=/tmp

[Service]
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
