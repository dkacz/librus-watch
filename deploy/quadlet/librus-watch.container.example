# Quadlet (rootless podman): ~/.config/containers/systemd/librus-watch.container
# Obraz budowany poza serwerem i przenoszony bez kodu źródłowego:
#   docker buildx build --platform linux/amd64 -f Containerfile -t librus-watch:<wersja> --load .
#   docker save librus-watch:<wersja> | ssh <serwer> podman load
#   ssh <serwer> podman tag docker.io/library/librus-watch:<wersja> localhost/librus-watch:<wersja>
# Potem: systemctl --user daemon-reload && systemctl --user start librus-watch

[Unit]
Description=librus-watch: powiadomienia o odstępstwach w Librusie
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=librus-watch
Image=localhost/librus-watch:<wersja>
Exec=run
# sieć z serwerem modelu (np. llama-swap); adres w config.yaml: http://llama-swap:8080/v1
Network=llm-net
# sieć z odbiornikiem telemetrii i korpusu (librus-telemetry.container)
Network=librus-net
UserNS=keep-id:uid=10001,gid=10001
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
Environment=TZ=Europe/Warsaw
EnvironmentFile=%h/.config/librus-watch/env
Volume=%h/.config/librus-watch/config.yaml:/config/config.yaml:ro,Z
Volume=%h/.config/librus-watch/secrets:/run/secrets:ro,Z
Volume=%h/.local/share/librus-watch:/data:Z
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=60
TimeoutStopSec=40

[Install]
WantedBy=default.target
